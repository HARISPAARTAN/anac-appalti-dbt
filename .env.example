# Copia in .env (git-ignorato) e usa: uv run --env-file .env appalti run
# Cartella di lavoro per data/, build/, logs/ (vuota = radice del repository)
APPALTI_HOME=
# User-Agent inviato al portale ANAC
APPALTI_USER_AGENT=anac-appalti-dbt/0.1 (+https://github.com/HARISPAARTAN/anac-appalti-dbt)
# Stato locale di Dagster per `dagster dev`
DAGSTER_HOME=.dagster
